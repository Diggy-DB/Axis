# Axis Flutter App - Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# Firebase Configuration
# Get these values from your Firebase Console > Project Settings
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_STORAGE_BUCKET=your_storage_bucket_here

# iOS specific (from GoogleService-Info.plist)
FIREBASE_IOS_CLIENT_ID=your_ios_client_id_here
FIREBASE_IOS_BUNDLE_ID=com.yourdomain.axis

# macOS specific (from GoogleService-Info.plist)
FIREBASE_MACOS_CLIENT_ID=your_macos_client_id_here
FIREBASE_MACOS_BUNDLE_ID=com.yourdomain.axis.macos

# Backend API Configuration
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=30

# Optional: App Configuration
APP_NAME=Axis
APP_VERSION=1.0.0
ENVIRONMENT=development
