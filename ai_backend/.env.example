# Axis AI Backend - Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# Firebase Admin SDK
# Download service account key from Firebase Console > Project Settings > Service Accounts
# Path to your Firebase service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./path/to/serviceAccountKey.json

# Alternatively, you can set individual Firebase credentials
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_PRIVATE_KEY_ID=your_private_key_id_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=info

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:*,https://yourdomain.com

# AI Engine Configuration
AI_LOOKBACK_DAYS=14
AI_MIN_DATA_POINTS=3
AI_CONFIDENCE_THRESHOLD=0.6

# Environment
ENVIRONMENT=development

# Optional: Future ML Model Configuration
# MODEL_PATH=./models/recommendation_model.pkl
# MODEL_VERSION=1.0.0
