# Axis Project - Root Environment Variables
# This file is for workspace-wide configuration
# Copy to .env and fill in your values

# Firebase Project Configuration
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_REGION=us-central1

# Google Cloud Configuration (for deployment)
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_REGION=us-central1
GCP_SERVICE_ACCOUNT=your_service_account_email_here

# GitHub Repository (optional)
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=axis

# Development
DEV_TEAM_ID=your_apple_dev_team_id
